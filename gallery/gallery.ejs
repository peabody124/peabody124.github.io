```{=html}
<div class="list gallery-grid">
<% for (const item of items) { %>
  <article class="gallery-card" <%= metadataAttrs(item) %>>
    <div class="gallery-media<% if (item.kind === 'youtube') { %> gallery-media-yt<% } %>">
      <% if (item.kind === 'youtube') { %>
        <button type="button" class="gallery-yt-trigger" data-yt-id="<%- item.youtube_id %>" data-yt-title="<%= item.title %>" aria-label="Play <%= item.title %> on YouTube">
          <img src="https://i.ytimg.com/vi/<%- item.youtube_id %>/hqdefault.jpg" alt="<%= item.title %>" class="gallery-img" loading="lazy">
          <span class="gallery-yt-play" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
        </button>
        <span class="gallery-kind-badge gallery-yt-badge"><i class="fa-brands fa-youtube"></i> YouTube</span>
      <% } else if (item.kind === 'video') { %>
        <video controls playsinline preload="none"<% if (item.poster) { %> poster="<%- item.poster %>"<% } %> class="gallery-video">
          <source src="<%- item.media %>" type="video/mp4">
        </video>
        <span class="gallery-kind-badge"><i class="fa-solid fa-film"></i> Clip</span>
      <% } else { %>
        <a href="<%- item.media %>" target="_blank" rel="noopener" class="gallery-img-link">
          <img src="<%- item.media %>" alt="<%= item.title %>" class="gallery-img" loading="lazy">
        </a>
      <% } %>
    </div>
    <div class="gallery-body">
      <div class="gallery-meta">
        <span class="pub-year-pill listing-date"><%= item.display_date %></span>
        <% if (item.categories && item.categories.length) { %>
          <span class="gallery-cat-pill"><%= item.categories[0] %></span>
        <% } %>
      </div>
      <% if (item.kind === 'youtube') { %>
        <h3 class="gallery-yt-title"><%= item.title %></h3>
      <% } %>
      <p class="gallery-caption listing-description"><%= item.caption %></p>
      <% if (item.post_url) { %>
        <a href="<%- item.post_url %>" class="gallery-post-link">Read post: <%= item.post_title || 'Build & Crash' %> &rarr;</a>
      <% } %>
      <div class="listing-title d-none"><%= item.title %></div>
      <% if (item.categories && item.categories.length) { %>
        <div class="listing-categories d-none">
          <% for (const cat of item.categories) { %>
            <div class="listing-category"><%= cat %></div>
          <% } %>
        </div>
      <% } %>
    </div>
  </article>
<% } %>
</div>
```